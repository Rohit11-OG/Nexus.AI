# NEXUS LLM Fallback — copy this file to .env and fill in ONE key.
# Free option: Get a Gemini key at https://aistudio.google.com (no credit card needed)

# Google Gemini (FREE tier — recommended)
GEMINI_API_KEY=

# OpenAI (paid)
OPENAI_API_KEY=

# Anthropic Claude (paid)
ANTHROPIC_API_KEY=

# App/runtime settings
SECRET_KEY=
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
ENGINE_MAX_SESSIONS=200
LOG_LEVEL=INFO
